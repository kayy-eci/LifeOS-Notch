{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeOS Notch",
  "version": "0.1.0",
  "identifier": "com.lifeos.notch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "notch",
        "title": "LifeOS Notch",
        "width": 360,
        "height": 44,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "visible": true,
        "focus": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "tooltip": "LifeOS Notch"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "A productivity notch for the top of your Windows desktop",
    "longDescription": "LifeOS Notch puts music controls, synced lyrics, a focus timer, water tracking and a Notion task list in a small notch at the top of your screen."
  }
}
